# --- Backend selection ---
# Set to "openai" for direct OpenAI API, or "genai_hub" for SAP AI Core / Generative AI Hub
MIRA_EMBEDDING_BACKEND=openai
MIRA_LLM_BACKEND=openai

# Model provider for GenAI Hub LLM: "openai" or "claude"
MIRA_GENAI_HUB_MODEL_PROVIDER=openai

# --- Direct OpenAI Configuration (used when MIRA_*_BACKEND=openai) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# --- SAP AI Core / Generative AI Hub Configuration (used when MIRA_*_BACKEND=genai_hub) ---
# Get these from your SAP BTP AI Core service instance
AICORE_AUTH_URL=https://your-auth-url.authentication.eu10.hana.ondemand.com/oauth/token
AICORE_CLIENT_ID=your-client-id
AICORE_CLIENT_SECRET=your-client-secret
AICORE_BASE_URL=https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com
AICORE_RESOURCE_GROUP=your-resource-group

# OpenAI Deployment (for chat completions)
AICORE_OPENAI_DEPLOYMENT_ID=your-openai-deployment-id
AICORE_OPENAI_MODEL=gpt-4o-mini

# Embedding Deployment
AICORE_OPENAI_EMBEDDING_DEPLOYMENT_ID=your-embedding-deployment-id
AICORE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Claude Deployment (optional, for alternative LLM)
AICORE_CLAUDE_DEPLOYMENT_ID=your-claude-deployment-id
AICORE_CLAUDE_MODEL=anthropic--claude-3-sonnet

# --- Vector store / feedback store ---
MIRA_VECTOR_STORE_BACKEND=faiss    # faiss | hana
MIRA_FEEDBACK_STORE_BACKEND=sqlite # sqlite | hana
MIRA_VECTOR_STORE_PATH=data/vector_store/index
MIRA_FEEDBACK_DB_PATH=data/feedback.db

# --- Production HANA values (fill in once BTP access exists) ---
# MIRA_VECTOR_STORE_BACKEND=hana
# MIRA_FEEDBACK_STORE_BACKEND=hana
# HANA_HOST=
# HANA_PORT=443
# HANA_USER=
# HANA_PASSWORD=